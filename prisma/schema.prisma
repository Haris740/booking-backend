generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String               @db.VarChar(100)
  email               String?              @unique @db.VarChar(255)
  profilePicture      String?
  phone               String               @unique @db.VarChar(20)
  passwordHash        String               @db.VarChar(255)
  city                String?              @db.VarChar(100)
  role                UserRole             @default(USER)
  isProfessional      Boolean              @default(false)
  professionalStatus  ProfessionalStatus   @default(NONE)
  isStaff             Boolean              @default(false)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  userBookings        Booking[]            @relation("UserBookings")
  professionalProfile ProfessionalProfile?
  staffProfile        Staff?
  staffInvitations    StaffInvitation[]

  @@index([email])
  @@index([phone])
  @@index([professionalStatus])
  @@map("users")
}

model ProfessionalCategory {
  id             Int                   @id @default(autoincrement())
  name           String                @db.VarChar(100)
  slug           String                @unique @db.VarChar(100)
  description    String?
  professionType String                @db.VarChar(50)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  profiles       ProfessionalProfile[]

  @@index([professionType])
  @@index([slug])
  @@map("professional_categories")
}

model ProfessionalProfile {
  id               String               @id @default(cuid())
  userId           String               @unique
  title            String               @db.VarChar(150)
  categoryId       Int
  about            String?
  yearsExperience  Int?
  city             String               @db.VarChar(100)
  address          String?
  consultationMode ConsultationMode     @default(OFFLINE)
  baseFee          Int?
  tags             String[]             @db.VarChar(50)
  proof            String?
  status           ProfessionalStatus   @default(PENDING)
  adminNote        String?
  bookingType      AppointmentType      @default(BOTH)
  tokenLimitPerDay Int?                 @default(50)
  availableDays    String[]             @default(dbgenerated("(ARRAY[]::character varying[])::character varying(20)[]")) @db.VarChar(20)
  startTime        String?              @db.VarChar(20)
  endTime          String?              @db.VarChar(20)
  breakStartTime   String?              @db.VarChar(20)
  breakEndTime     String?              @db.VarChar(20)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  proBookings      Booking[]            @relation("ProBookings")
  staffMembers     Staff[]              @relation("StaffMembers")
  staffInvitations StaffInvitation[]    @relation("StaffInvitations")
  category         ProfessionalCategory @relation(fields: [categoryId], references: [id])
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([city, status])
  @@index([categoryId, status])
  @@map("professional_profiles")
}

model Booking {
  id                String              @id @default(cuid())
  userId            String
  professionalId    String
  name              String              @db.VarChar(100)
  age               Int
  gender            Gender
  phone             String              @db.VarChar(20)
  appointmentDate   DateTime
  appointmentType   AppointmentType
  tokenNumber       Int?
  timeSlot          String?             @db.VarChar(50)
  status            BookingStatus       @default(PENDING)
  estimatedWaitTime Int?
  notificationsSent Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  professional      ProfessionalProfile @relation("ProBookings", fields: [professionalId], references: [id], onDelete: Cascade)
  user              User                @relation("UserBookings", fields: [userId], references: [id], onDelete: Cascade)

  @@index([professionalId, appointmentDate, status])
  @@index([userId])
  @@index([tokenNumber])
  @@map("bookings")
}

model Staff {
  id             String @id @default(cuid())
  userId         String @unique
  professionalId String

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  professional ProfessionalProfile @relation("StaffMembers", fields: [professionalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionalId])
  @@map("staff")
}

model StaffInvitation {
  id             String      @id @default(cuid())
  professionalId String
  invitedUserId  String
  status         StaffStatus @default(PENDING)
  message        String?     @db.Text

  invitedUser  User                @relation(fields: [invitedUserId], references: [id], onDelete: Cascade)
  professional ProfessionalProfile @relation("StaffInvitations", fields: [professionalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([professionalId, invitedUserId])
  @@index([invitedUserId, status])
  @@map("staff_invitations")
}

enum UserRole {
  USER
  ADMIN
  STAFF
}

enum ProfessionalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum ConsultationMode {
  ONLINE
  OFFLINE
  BOTH
}

enum StaffStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  IN_PROGRESS
  NO_SHOW
}

enum AppointmentType {
  TOKEN
  TIMESLOT
  BOTH
}

enum Gender {
  MALE
  FEMALE
  OTHER
}
