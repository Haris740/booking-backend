generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ProfessionalStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum ConsultationMode {
  ONLINE
  OFFLINE
  BOTH
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  IN_PROGRESS
  NO_SHOW
}

enum AppointmentType {
  TOKEN
  TIMESLOT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id             String  @id @default(cuid())
  name           String  @db.VarChar(100)
  email          String? @unique @db.VarChar(255)
  profilePicture String? @db.Text
  phone          String  @unique @db.VarChar(20)
  passwordHash   String  @db.VarChar(255)
  city           String? @db.VarChar(100)

  role               UserRole           @default(USER)
  isProfessional     Boolean            @default(false)
  professionalStatus ProfessionalStatus @default(NONE)
  adminNote          String?            @db.Text

  // Relations
  professionalProfile ProfessionalProfile?
  userBookings        Booking[]            @relation("UserBookings")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([phone])
  @@index([professionalStatus])
  @@map("users")
}

model ProfessionalCategory {
  id             Int     @id @default(autoincrement())
  name           String  @db.VarChar(100)
  slug           String  @unique @db.VarChar(100)
  description    String? @db.Text
  professionType String  @db.VarChar(50)

  profiles ProfessionalProfile[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([professionType])
  @@index([slug])
  @@map("professional_categories")
}

model ProfessionalProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title      String               @db.VarChar(150)
  categoryId Int
  category   ProfessionalCategory @relation(fields: [categoryId], references: [id])

  about            String?          @db.Text
  yearsExperience  Int?
  city             String           @db.VarChar(100)
  address          String?          @db.Text
  consultationMode ConsultationMode @default(ONLINE)
  baseFee          Int?
  tags             String[]         @db.VarChar(50)

  status    ProfessionalStatus @default(PENDING)
  adminNote String?            @db.Text

  // Token system settings
  tokenLimitPerDay Int?     @default(50)
  availableDays    String[] @default([]) @db.VarChar(20)
  startTime        String?  @db.VarChar(20)
  endTime          String?  @db.VarChar(20)
  breakStartTime   String?  @db.VarChar(20)
  breakEndTime     String?  @db.VarChar(20)

  // Relations
  proBookings Booking[] @relation("ProBookings")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([city, status])
  @@index([categoryId, status])
  @@map("professional_profiles")
}

model Booking {
  id                String          @id @default(cuid())
  userId            String
  professionalId    String
  patientName       String          @db.VarChar(100)
  patientAge        Int
  patientGender     Gender
  patientPhone      String          @db.VarChar(20)
  disease           String?         @db.VarChar(255)
  symptoms          String?         @db.Text
  appointmentDate   DateTime
  appointmentType   AppointmentType
  tokenNumber       Int?
  timeSlot          String?         @db.VarChar(50)
  status            BookingStatus   @default(PENDING)
  estimatedWaitTime Int?
  notificationsSent Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  // Relations
  user         User                @relation("UserBookings", fields: [userId], references: [id], onDelete: Cascade)
  professional ProfessionalProfile @relation("ProBookings", fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId, appointmentDate, status])
  @@index([userId])
  @@index([tokenNumber])
  @@map("bookings")
}